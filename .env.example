# Copy to .env.local and fill in. Never commit the filled-in file.

# ── Supabase ─────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Never expose to the client. Used for admin actions (role changes, storage cleanup).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Traffic Discipline Bangladesh"

# ── Report ID ────────────────────────────────────────────
# Prefix + year used when generating IDs, e.g. TDB-2026-483920
NEXT_PUBLIC_REPORT_PREFIX=TDB

# ── Rate limiting (in-memory / Upstash) ─────────────────
# Optional: if set, rate limiting uses Upstash Redis instead of the
# in-memory fallback (recommended in production / serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Maps ─────────────────────────────────────────────────
# OpenStreetMap/Leaflet needs no key. Default map center is Dhaka.
NEXT_PUBLIC_DEFAULT_MAP_LAT=23.8103
NEXT_PUBLIC_DEFAULT_MAP_LNG=90.4125

# ── AI decision support (Milestone 4) ───────────────────
# Optional. Powers "Summarize Case" and "Suggest Category" in the
# officer console (src/lib/ai/report-ai.ts). Left unset, those buttons
# show a clear "not configured" message instead of failing.
ANTHROPIC_API_KEY=

# ── Notifications (Milestone 4) ─────────────────────────
# Optional. Each is a provider abstraction (src/lib/notifications/) that
# logs to the console instead of sending when its key is unset.
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=

# Web Push. Generate a VAPID key pair (e.g. `npx web-push generate-vapid-keys`)
# and set both — the public key is safe to expose to the client.
NEXT_PUBLIC_PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
